--- /dev/null
+++ b/ggml/src/ggml-metal/ggml-metal-profile.h
@@ -0,0 +1,48 @@
+#pragma once
+
+// opt-in profiling of the Metal graph compute, enabled with GGML_METAL_PROFILE
+//
+//   GGML_METAL_PROFILE=1  every node that encodes GPU work goes into its own command buffer, which is committed and
+//                         waited on; GPU time (GPUEndTime - GPUStartTime) and wall time are recorded per node.
+//                         only graphs that process a single token are profiled this way (GGML_METAL_PROFILE_ALL=1
+//                         profiles every graph); the rest run normally and are only counted.
+//   GGML_METAL_PROFILE=2  normal encoding (no per-node waits); records the CPU time of each graph compute, the CPU
+//                         time spent encoding, and the GPU span of the graph's command buffers.
+//
+//   GGML_METAL_PROFILE_OUT        path of the JSON file written at exit (default: ggml-metal-profile.json)
+//   GGML_METAL_PROFILE_NODES_MAX  number of profiled graphs whose per-node list is kept (default: 12)
+
+#include "ggml.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct ggml_metal_profile * ggml_metal_profile_t;
+
+// returns NULL when GGML_METAL_PROFILE is not set (or 0)
+ggml_metal_profile_t ggml_metal_profile_init(void);
+void                 ggml_metal_profile_free(ggml_metal_profile_t p); // writes the JSON
+
+int  ggml_metal_profile_mode(ggml_metal_profile_t p);
+bool ggml_metal_profile_all (ggml_metal_profile_t p);
+
+// tokens processed by the graph: src1->ne[1] of the first MUL_MAT (-1 if there is none)
+int ggml_metal_profile_n_tokens(const struct ggml_cgraph * gf);
+
+// mode 1
+void ggml_metal_profile_graph_begin(ggml_metal_profile_t p, const struct ggml_cgraph * gf, int n_tokens, bool profiled);
+void ggml_metal_profile_node(ggml_metal_profile_t p, const struct ggml_cgraph * gf, int graph_idx, int n_fuse,
+        int n_dispatch, double gpu_s, double wall_s, double enc_s);
+void ggml_metal_profile_node_empty(ggml_metal_profile_t p, const struct ggml_tensor * node); // encoded no GPU work
+void ggml_metal_profile_graph_end(ggml_metal_profile_t p, int n_nodes_filtered, double wall_s, double empty_cb_gpu_s);
+
+// mode 2
+void ggml_metal_profile_compute(ggml_metal_profile_t p, int n_nodes, int n_tokens, int n_cb,
+        double cpu_compute_s, double cpu_encode_main_s, double cpu_encode_all_s);
+// GPU timing of the command buffers of the last recorded compute (harvested after completion)
+void ggml_metal_profile_compute_gpu(ggml_metal_profile_t p, double gpu_span_s, double gpu_sum_s, double submit_to_gpu_start_s, double submit_to_gpu_end_s);
+
+#ifdef __cplusplus
+}
+#endif
