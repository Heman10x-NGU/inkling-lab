+// mode 2: read the GPU timing of the command buffers of the last graph compute, once they have all completed
+static void ggml_metal_prof_harvest(ggml_metal_t ctx) {
+    const int n_cb = ctx->prof_pending_n_cb;
+
+    double t_start = 0.0;
+    double t_end   = 0.0;
+    double sum     = 0.0;
+
+    for (int cb_idx = 0; cb_idx <= n_cb; ++cb_idx) {
+        id<MTLCommandBuffer> cmd_buf = ctx->cmd_bufs[cb_idx].obj;
+        if (!cmd_buf || [cmd_buf status] != MTLCommandBufferStatusCompleted) {
+            return; // not done yet, try again later
+        }
+        const double s = [cmd_buf GPUStartTime];
+        const double e = [cmd_buf GPUEndTime];
+        if (cb_idx == 0 || s < t_start) {
+            t_start = s;
+        }
+        if (cb_idx == 0 || e > t_end) {
+            t_end = e;
+        }
+        sum += e - s;
+    }
+
+    ggml_metal_profile_compute_gpu(ctx->prof, t_end - t_start, sum, t_start - ctx->prof_t_submit, t_end - ctx->prof_t_submit);
+
+    ctx->prof_pending = false;
+}
+
+// mode 1: encode every node that issues GPU work into its own command buffer, commit it and wait for it
+static enum ggml_status ggml_metal_graph_compute_profiled(ggml_metal_t ctx, struct ggml_cgraph * gf, int n_tokens) {
+    @autoreleasepool {
+        const double t_graph = ggml_metal_prof_now();
+
+        // finish any earlier work so it does not count against the first node
+        if (ctx->cmd_buf_last) {
+            [ctx->cmd_buf_last waitUntilCompleted];
+            ctx->cmd_buf_last = nil;
+        }
+
+        ggml_metal_device_rsets_keep_alive(ctx->dev);
+
+        ggml_metal_profile_graph_begin(ctx->prof, gf, n_tokens, true);
+
+        id<MTLCommandQueue> queue = ggml_metal_device_get_queue(ctx->dev);
+
+        id<MTLCommandBuffer> cmd_buf = [queue commandBuffer];
+
+        ggml_metal_op_t ctx_op = ggml_metal_op_init(
+            ctx->dev,
+            cmd_buf,
+            gf,
+            ctx->finfo,
+            0,
+            gf->n_nodes,
+            ctx->use_concurrency,
+            false,
+            ctx->debug_graph);
+
+        enum ggml_status res = GGML_STATUS_SUCCESS;
+
+        const int n_nodes = ggml_metal_op_n_nodes(ctx_op);
+
+        for (int idx = 0; idx < n_nodes; ++idx) {
+            const double t0 = ggml_metal_prof_now();
+            const int    d0 = ggml_metal_op_n_dispatch(ctx_op);
+
+            const int n_fuse = ggml_metal_op_encode(ctx_op, idx);
+            if (n_fuse == 0) {
+                break;
+            }
+
+            const int n_disp = ggml_metal_op_n_dispatch(ctx_op) - d0;
+
+            if (n_disp == 0) {
+                ggml_metal_profile_node_empty(ctx->prof, ggml_metal_op_node(ctx_op, idx));
+                idx += n_fuse - 1;
+                continue;
+            }
+
+            const double t_enc = ggml_metal_prof_now();
+
+            // close this node's encoder, continue in a fresh command buffer, run this one alone
+            id<MTLCommandBuffer> cmd_buf_next = [queue commandBuffer];
+            ggml_metal_op_set_cmd_buf(ctx_op, cmd_buf_next);
+
+            [cmd_buf commit];
+            [cmd_buf waitUntilCompleted];
+
+            const double t1 = ggml_metal_prof_now();
+
+            if ([cmd_buf status] != MTLCommandBufferStatusCompleted) {
+                GGML_LOG_ERROR("%s: command buffer failed with status %d\n", __func__, (int) [cmd_buf status]);
+                res = GGML_STATUS_FAILED;
+            }
+
+            const double gpu_s = [cmd_buf GPUEndTime] - [cmd_buf GPUStartTime];
+
+            ggml_metal_profile_node(ctx->prof, gf, ggml_metal_op_graph_idx(ctx_op, idx), n_fuse, n_disp, gpu_s, t1 - t0, t_enc - t0);
+
+            cmd_buf = cmd_buf_next;
+            idx += n_fuse - 1;
+
+            if (res != GGML_STATUS_SUCCESS) {
+                break;
+            }
+        }
+
+        // ends the last (empty) encoder
+        ggml_metal_op_free(ctx_op);
+
+        [cmd_buf commit];
+        [cmd_buf waitUntilCompleted];
+
+        // the last command buffer holds an empty encoder: its GPU time is the fixed cost of one command buffer
+        const double empty_gpu_s = [cmd_buf GPUEndTime] - [cmd_buf GPUStartTime];
+
+        ggml_metal_profile_graph_end(ctx->prof, n_nodes, ggml_metal_prof_now() - t_graph, empty_gpu_s);
+
+        return res;
+    }
+}
