diff --git a/ggml/src/ggml-metal/ggml-metal-profile.cpp b/ggml/src/ggml-metal/ggml-metal-profile.cpp
new file mode 100644
index 000000000..e150a7787
--- /dev/null
+++ b/ggml/src/ggml-metal/ggml-metal-profile.cpp
@@ -0,0 +1,330 @@
+#include "ggml-metal-profile.h"
+
+#include "ggml-impl.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <map>
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+namespace {
+
+struct op_sum {
+    int64_t count  = 0;
+    double  gpu_s  = 0.0;
+    double  wall_s = 0.0;
+    double  enc_s  = 0.0;
+};
+
+struct node_rec {
+    int         graph_idx;
+    int         n_fuse;
+    int         n_dispatch;
+    std::string op;
+    std::string name;
+    double      gpu_s;
+    double      wall_s;
+};
+
+struct graph_rec {
+    int64_t seq      = 0;
+    int     n_tokens = 0;
+    int     n_nodes  = 0;
+    bool    profiled = false;
+
+    // mode 1
+    int     n_nodes_filtered = 0; // nodes left after dropping empty ones
+    int64_t n_units          = 0; // encode calls that issued GPU work (a fused group counts once)
+    int64_t n_dispatch       = 0; // kernel dispatches (an op can issue several)
+    int64_t n_fused_nodes    = 0; // nodes absorbed into a fused unit beyond its first
+    int64_t n_empty          = 0; // encode calls that issued no GPU work
+    double  gpu_s            = 0.0;
+    double  wall_s           = 0.0; // sum of per-node wall times
+    double  graph_wall_s     = 0.0; // wall time of the whole profiled graph compute
+    double  empty_cb_gpu_s   = 0.0; // GPU time of a command buffer holding one empty encoder
+
+    std::map<std::string, op_sum>  ops;
+    std::map<std::string, int64_t> empty_ops;
+    std::vector<node_rec>          nodes;
+
+    // mode 2
+    int    n_cb                  = 0;
+    double cpu_compute_s         = 0.0;
+    double cpu_encode_main_s     = 0.0;
+    double cpu_encode_all_s      = 0.0;
+    bool   has_gpu               = false;
+    double gpu_span_s            = 0.0;
+    double gpu_sum_s             = 0.0;
+    double submit_to_gpu_start_s = 0.0;
+    double submit_to_gpu_end_s   = 0.0;
+};
+
+std::string json_str(const std::string & s) {
+    std::string r = "\"";
+    for (char c : s) {
+        if (c == '"' || c == '\\') {
+            r += '\\';
+            r += c;
+        } else if ((unsigned char) c < 0x20) {
+            char buf[8];
+            snprintf(buf, sizeof(buf), "\\u%04x", c);
+            r += buf;
+        } else {
+            r += c;
+        }
+    }
+    return r + "\"";
+}
+
+} // namespace
+
+struct ggml_metal_profile {
+    int         mode      = 0;
+    bool        all       = false;
+    int         nodes_max = 12;
+    std::string out;
+
+    int64_t n_profiled = 0;
+
+    std::vector<graph_rec> graphs;
+
+    // structure of the first profiled graph: every node with its sources
+    std::string graph_dump;
+};
+
+ggml_metal_profile_t ggml_metal_profile_init(void) {
+    const char * val = getenv("GGML_METAL_PROFILE");
+    if (!val || atoi(val) <= 0) {
+        return nullptr;
+    }
+
+    auto * p = new ggml_metal_profile();
+
+    p->mode = atoi(val);
+    p->all  = getenv("GGML_METAL_PROFILE_ALL") != nullptr;
+
+    const char * out = getenv("GGML_METAL_PROFILE_OUT");
+    p->out = out ? out : "ggml-metal-profile.json";
+
+    const char * nmax = getenv("GGML_METAL_PROFILE_NODES_MAX");
+    if (nmax) {
+        p->nodes_max = atoi(nmax);
+    }
+
+    p->graphs.reserve(4096);
+
+    GGML_LOG_INFO("%s: GGML_METAL_PROFILE = %d, output = %s\n", __func__, p->mode, p->out.c_str());
+
+    return p;
+}
+
+int ggml_metal_profile_mode(ggml_metal_profile_t p) {
+    return p ? p->mode : 0;
+}
+
+bool ggml_metal_profile_all(ggml_metal_profile_t p) {
+    return p && p->all;
+}
+
+int ggml_metal_profile_n_tokens(const ggml_cgraph * gf) {
+    for (int i = 0; i < gf->n_nodes; ++i) {
+        const ggml_tensor * t = gf->nodes[i];
+        if (t->op == GGML_OP_MUL_MAT && t->src[1]) {
+            return (int) t->src[1]->ne[1];
+        }
+    }
+    return -1;
+}
+
+static void dump_graph(ggml_metal_profile_t p, const ggml_cgraph * gf) {
+    std::unordered_map<const ggml_tensor *, int> idx;
+    for (int i = 0; i < gf->n_nodes; ++i) {
+        idx[gf->nodes[i]] = i;
+    }
+
+    std::string & s = p->graph_dump;
+    s = "[\n";
+    for (int i = 0; i < gf->n_nodes; ++i) {
+        const ggml_tensor * t = gf->nodes[i];
+        char buf[256];
+        snprintf(buf, sizeof(buf), "    [%d, %s, %s, [%lld, %lld, %lld, %lld], %s, [", i,
+                json_str(ggml_op_desc(t)).c_str(), json_str(t->name).c_str(),
+                (long long) t->ne[0], (long long) t->ne[1], (long long) t->ne[2], (long long) t->ne[3],
+                (t->flags & GGML_TENSOR_FLAG_COMPUTE) ? "true" : "false");
+        s += buf;
+        bool first = true;
+        for (int j = 0; j < GGML_MAX_SRC; ++j) {
+            const ggml_tensor * src = t->src[j];
+            if (!src) {
+                continue;
+            }
+            if (!first) {
+                s += ", ";
+            }
+            first = false;
+            auto it = idx.find(src);
+            if (it != idx.end()) {
+                s += std::to_string(it->second);
+            } else {
+                s += json_str(src->name);
+            }
+        }
+        s += (i + 1 < gf->n_nodes) ? "]],\n" : "]]\n";
+    }
+    s += "  ]";
+}
+
+void ggml_metal_profile_graph_begin(ggml_metal_profile_t p, const ggml_cgraph * gf, int n_tokens, bool profiled) {
+    graph_rec g;
+    g.seq      = (int64_t) p->graphs.size();
+    g.n_tokens = n_tokens;
+    g.n_nodes  = gf->n_nodes;
+    g.profiled = profiled;
+    p->graphs.push_back(std::move(g));
+
+    if (profiled) {
+        if (p->graph_dump.empty()) {
+            dump_graph(p, gf);
+        }
+        p->n_profiled++;
+    }
+}
+
+void ggml_metal_profile_node(ggml_metal_profile_t p, const ggml_cgraph * gf, int graph_idx, int n_fuse,
+        int n_dispatch, double gpu_s, double wall_s, double enc_s) {
+    graph_rec & g = p->graphs.back();
+
+    std::string op;
+    for (int i = 0; i < n_fuse; ++i) {
+        if (i > 0) {
+            op += "+";
+        }
+        op += ggml_op_desc(gf->nodes[graph_idx + i]);
+    }
+
+    op_sum & s = g.ops[op];
+    s.count  += 1;
+    s.gpu_s  += gpu_s;
+    s.wall_s += wall_s;
+    s.enc_s  += enc_s;
+
+    g.n_units       += 1;
+    g.n_dispatch    += n_dispatch;
+    g.n_fused_nodes += n_fuse - 1;
+    g.gpu_s         += gpu_s;
+    g.wall_s        += wall_s;
+
+    if (p->n_profiled <= p->nodes_max) {
+        g.nodes.push_back({ graph_idx, n_fuse, n_dispatch, op, gf->nodes[graph_idx]->name, gpu_s, wall_s });
+    }
+}
+
+void ggml_metal_profile_node_empty(ggml_metal_profile_t p, const ggml_tensor * node) {
+    graph_rec & g = p->graphs.back();
+    g.n_empty += 1;
+    g.empty_ops[ggml_op_desc(node)] += 1;
+}
+
+void ggml_metal_profile_graph_end(ggml_metal_profile_t p, int n_nodes_filtered, double wall_s, double empty_cb_gpu_s) {
+    graph_rec & g = p->graphs.back();
+    g.n_nodes_filtered = n_nodes_filtered;
+    g.graph_wall_s     = wall_s;
+    g.empty_cb_gpu_s   = empty_cb_gpu_s;
+}
+
+void ggml_metal_profile_compute(ggml_metal_profile_t p, int n_nodes, int n_tokens, int n_cb,
+        double cpu_compute_s, double cpu_encode_main_s, double cpu_encode_all_s) {
+    graph_rec g;
+    g.seq               = (int64_t) p->graphs.size();
+    g.n_tokens          = n_tokens;
+    g.n_nodes           = n_nodes;
+    g.n_cb              = n_cb;
+    g.cpu_compute_s     = cpu_compute_s;
+    g.cpu_encode_main_s = cpu_encode_main_s;
+    g.cpu_encode_all_s  = cpu_encode_all_s;
+    p->graphs.push_back(std::move(g));
+}
+
+void ggml_metal_profile_compute_gpu(ggml_metal_profile_t p, double gpu_span_s, double gpu_sum_s, double submit_to_gpu_start_s, double submit_to_gpu_end_s) {
+    if (p->graphs.empty()) {
+        return;
+    }
+    graph_rec & g = p->graphs.back();
+    g.has_gpu               = true;
+    g.gpu_span_s            = gpu_span_s;
+    g.gpu_sum_s             = gpu_sum_s;
+    g.submit_to_gpu_start_s = submit_to_gpu_start_s;
+    g.submit_to_gpu_end_s   = submit_to_gpu_end_s;
+}
+
+static void write_json(ggml_metal_profile_t p) {
+    FILE * f = fopen(p->out.c_str(), "w");
+    if (!f) {
+        GGML_LOG_ERROR("%s: failed to open %s\n", __func__, p->out.c_str());
+        return;
+    }
+
+    fprintf(f, "{\n  \"mode\": %d,\n  \"profile_all\": %s,\n  \"graphs\": [\n", p->mode, p->all ? "true" : "false");
+    for (size_t gi = 0; gi < p->graphs.size(); ++gi) {
+        const graph_rec & g = p->graphs[gi];
+        fprintf(f, "    {\"seq\": %lld, \"n_tokens\": %d, \"n_nodes\": %d, \"profiled\": %s",
+                (long long) g.seq, g.n_tokens, g.n_nodes, g.profiled ? "true" : "false");
+        if (p->mode == 2) {
+            fprintf(f, ", \"n_cb\": %d, \"cpu_compute_us\": %.3f, \"cpu_encode_main_us\": %.3f, \"cpu_encode_all_us\": %.3f",
+                    g.n_cb, g.cpu_compute_s*1e6, g.cpu_encode_main_s*1e6, g.cpu_encode_all_s*1e6);
+            if (g.has_gpu) {
+                fprintf(f, ", \"gpu_span_us\": %.3f, \"gpu_sum_us\": %.3f, \"submit_to_gpu_start_us\": %.3f, \"submit_to_gpu_end_us\": %.3f",
+                        g.gpu_span_s*1e6, g.gpu_sum_s*1e6, g.submit_to_gpu_start_s*1e6, g.submit_to_gpu_end_s*1e6);
+            }
+        }
+        if (g.profiled) {
+            fprintf(f, ",\n     \"n_nodes_filtered\": %d, \"n_units\": %lld, \"n_dispatch\": %lld, \"n_fused_nodes\": %lld, \"n_empty\": %lld,"
+                       " \"gpu_us\": %.3f, \"wall_us\": %.3f, \"graph_wall_us\": %.3f, \"empty_cb_gpu_us\": %.3f,\n     \"ops\": {",
+                    g.n_nodes_filtered, (long long) g.n_units, (long long) g.n_dispatch, (long long) g.n_fused_nodes, (long long) g.n_empty,
+                    g.gpu_s*1e6, g.wall_s*1e6, g.graph_wall_s*1e6, g.empty_cb_gpu_s*1e6);
+            bool first = true;
+            for (const auto & kv : g.ops) {
+                fprintf(f, "%s%s: [%lld, %.3f, %.3f, %.3f]", first ? "" : ", ", json_str(kv.first).c_str(),
+                        (long long) kv.second.count, kv.second.gpu_s*1e6, kv.second.wall_s*1e6, kv.second.enc_s*1e6);
+                first = false;
+            }
+            fprintf(f, "},\n     \"empty_ops\": {");
+            first = true;
+            for (const auto & kv : g.empty_ops) {
+                fprintf(f, "%s%s: %lld", first ? "" : ", ", json_str(kv.first).c_str(), (long long) kv.second);
+                first = false;
+            }
+            fprintf(f, "}");
+            if (!g.nodes.empty()) {
+                fprintf(f, ",\n     \"nodes\": [\n");
+                for (size_t i = 0; i < g.nodes.size(); ++i) {
+                    const node_rec & n = g.nodes[i];
+                    fprintf(f, "       [%d, %d, %d, %s, %s, %.3f, %.3f]%s\n", n.graph_idx, n.n_fuse, n.n_dispatch,
+                            json_str(n.op).c_str(), json_str(n.name).c_str(), n.gpu_s*1e6, n.wall_s*1e6,
+                            i + 1 < g.nodes.size() ? "," : "");
+                }
+                fprintf(f, "     ]");
+            }
+        }
+        fprintf(f, "}%s\n", gi + 1 < p->graphs.size() ? "," : "");
+    }
+    fprintf(f, "  ],\n");
+    fprintf(f, "  \"ops_columns\": [\"count\", \"gpu_us\", \"wall_us\", \"cpu_encode_us\"],\n");
+    fprintf(f, "  \"nodes_columns\": [\"graph_idx\", \"n_fuse\", \"n_dispatch\", \"op\", \"name\", \"gpu_us\", \"wall_us\"],\n");
+    fprintf(f, "  \"graph_structure_columns\": [\"idx\", \"op\", \"name\", \"ne\", \"compute_flag\", \"srcs (node idx or leaf name)\"],\n");
+    fprintf(f, "  \"graph_structure\": %s\n}\n", p->graph_dump.empty() ? "null" : p->graph_dump.c_str());
+
+    fclose(f);
+
+    GGML_LOG_INFO("%s: wrote %zu graph records to %s\n", __func__, p->graphs.size(), p->out.c_str());
+}
+
+void ggml_metal_profile_free(ggml_metal_profile_t p) {
+    if (!p) {
+        return;
+    }
+    write_json(p);
+    delete p;
+}
diff --git a/ggml/src/ggml-metal/ggml-metal-profile.h b/ggml/src/ggml-metal/ggml-metal-profile.h
new file mode 100644
