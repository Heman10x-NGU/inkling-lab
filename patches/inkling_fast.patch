+// tensors derived from the loaded weights once, instead of on every graph
+void llama_model_inkling2::load_arch_tensors_post() {
+    const int n_layer      = (int) hparams.n_layer();
+    const int n_layer_phys = n_layer - (int) hparams.loop_n_extra();
+
+    // after loading, the weights of physical layer ip sit in the slot of its first visit, loop_visit(ip)
+    std::vector<derived_tensor> list;
+    for (int ip = 0; ip < n_layer_phys; ++ip) {
+        auto & layer = layers[hparams.loop_visit(ip)];
+
+        // the relative-bias table gets a zero row for the distances outside the extent
+        list.push_back({ &layer.attn_rel_bias_pad, layer.attn_rel_bias->type, layer.attn_rel_bias->ne[0], layer.attn_rel_bias->ne[1] + 1,
+                layer.attn_rel_bias, format("blk.%d.attn_rel_bias_pad", ip), { layer.attn_rel_bias } });
+    }
+
+    load_tensors_derived(list);
+
+    // every visit shares the derived tensors of its physical layer
+    for (int il = 0; il < n_layer; ++il) {
+        const auto & src = layers[hparams.loop_visit(hparams.loop_layer(il))];
+
+        layers[il].attn_rel_bias_pad = src.attn_rel_bias_pad;
+    }
+}
