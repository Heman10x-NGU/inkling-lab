+void llama_model_base::load_tensors_derived(const std::vector<derived_tensor> & list) {
+    std::map<ggml_backend_buffer_type_t, std::vector<const derived_tensor *>> by_buft;
+    for (const auto & d : list) {
+        GGML_ASSERT(d.like && d.like->buffer);
+        ggml_backend_buffer_type_t buft = ggml_backend_buffer_get_type(d.like->buffer);
+        // the device's own buffer type: the weights may sit in a type for mapped file memory or for repacked tensors
+        if (ggml_backend_dev_t dev = ggml_backend_buft_get_device(buft)) {
+            buft = ggml_backend_dev_buffer_type(dev);
+        }
+        by_buft[buft].push_back(&d);
+    }
+
+    for (auto & [buft, items] : by_buft) {
+        ggml_init_params params = {
+            /*.mem_size   =*/ items.size()*ggml_tensor_overhead(),
+            /*.mem_buffer =*/ NULL,
+            /*.no_alloc   =*/ true,
+        };
+        ggml_context_ptr ctx { ggml_init(params) };
+        if (!ctx) {
+            throw std::runtime_error("failed to create the derived tensor context");
+        }
+
+        std::vector<ggml_tensor *> tensors;
+        for (const derived_tensor * d : items) {
+            ggml_tensor * t = ggml_new_tensor_2d(ctx.get(), d->type, d->ne0, d->ne1);
+            ggml_set_name(t, d->name.c_str());
+            tensors.push_back(t);
+        }
+
+        ggml_backend_buffer_ptr buffer { ggml_backend_alloc_ctx_tensors_from_buft(ctx.get(), buft) };
+        if (!buffer) {
+            throw std::runtime_error(format("unable to allocate %s derived tensor buffer", ggml_backend_buft_name(buft)));
+        }
+        ggml_backend_buffer_set_usage(buffer.get(), GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+
+        size_t n_bytes = 0;
+        for (size_t i = 0; i < items.size(); ++i) {
+            const derived_tensor * d = items[i];
+            ggml_tensor * t = tensors[i];
+
+            // the whole tensor is written in one set: the parts, then zeros
+            std::vector<uint8_t> data(ggml_nbytes(t), 0);
+            size_t offset = 0;
+            for (ggml_tensor * part : d->parts) {
+                if (part->type != d->type || part->ne[0] != d->ne0 || !ggml_is_contiguous(part) || part->ne[2] != 1 || part->ne[3] != 1) {
+                    throw std::runtime_error(format("derived tensor %s: incompatible part %s", d->name.c_str(), part->name));
+                }
+                if (offset + ggml_nbytes(part) > data.size()) {
+                    throw std::runtime_error(format("derived tensor %s: parts exceed its size", d->name.c_str()));
+                }
+                ggml_backend_tensor_get(part, data.data() + offset, 0, ggml_nbytes(part));
+                offset += ggml_nbytes(part);
+            }
+            ggml_backend_tensor_set(t, data.data(), 0, data.size());
+            n_bytes += ggml_nbytes(t);
+            *d->dst = t;
+        }
+
+        LLAMA_LOG_INFO("%s: %zu derived tensors, %s buffer size = %.2f MiB\n", __func__, items.size(),
+                ggml_backend_buft_name(buft), n_bytes/1024.0/1024.0);
+
+        std::vector<ggml_backend_buffer_ptr> buffers;
+        buffers.emplace_back(std::move(buffer));
+        pimpl->ctxs_bufs.emplace_back(std::move(ctx), std::move(buffers));
+    }
+}
